--- a/apps/web/src/i18n.ts
+++ b/apps/web/src/i18n.ts
@@ -1,4 +1,4 @@
-import type { Ability, Locale, Text } from '@dndroll/core';
+import type { Ability, Locale, Text, VersionId } from '@dndroll/core';
 
 /** UI 界面文案。规则说明文字一律来自 @dndroll/core，本文件只包含界面框架文本。 */
 const dict = {
@@ -153,3 +153,9 @@ export const abilityNames: Record<Ability, Text> = {
   WIS: { zh: '感知', en: 'Wisdom' },
