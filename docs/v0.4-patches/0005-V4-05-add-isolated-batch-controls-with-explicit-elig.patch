diff --git a/apps/web/src/components/BatchPanel.tsx b/apps/web/src/components/BatchPanel.tsx
new file mode 100644
index 0000000..0d81606
--- /dev/null
+++ b/apps/web/src/components/BatchPanel.tsx
@@ -0,0 +1,37 @@
+import { useState } from 'react';
+import { BATCH_COUNTS, generateBatch, getMethod, isBatchMethod, RuleError, type BatchEntry, type CreateRequest, type Locale, type Rng, type Text } from '@dndroll/core';
+import { t } from '../i18n';
+
+/** Batch results live only here, independently of the single-session controller. */
+export function BatchPanel({ request, locale, rng }: { request: CreateRequest | null; locale: Locale; rng?: Rng }) {
+  const [count, setCount] = useState(4);
+  const [entries, setEntries] = useState<BatchEntry[]>([]);
+  const [error, setError] = useState<Text | null>(null);
+  const eligible = request && isBatchMethod(getMethod(request.methodId), request.options);
+  const generate = () => {
+    if (!request || !eligible) return;
+    try {
+      const next = generateBatch(request, count, rng);
+      setEntries(next); setError(null);
+    } catch (e) {
+      setError(e instanceof RuleError ? e.messages : {zh:`批量生成失败：${String(e)}`,en:`Batch generation failed: ${String(e)}`});
+    }
+  };
+  if (!eligible && !entries.length && !error) return null;
+  return <section className="panel batch-panel" aria-label={t('batchTitle', locale)}>
+    <h2>{t('batchTitle', locale)}</h2>
+    <p className="panel-hint">{t('batchLifetime', locale)}</p>
+    {eligible && request && <>
+      <p className="batch-method">{getMethod(request.methodId).name[locale]}</p>
+      <div className="batch-controls">
+        <label>{t('batchCount', locale)} <select aria-label={t('batchCount', locale)} value={count} onChange={e=>setCount(Number(e.target.value))}>
+          {BATCH_COUNTS.map(n=><option key={n} value={n}>{n}</option>)}
+        </select></label>
+        <button type="button" className="btn btn-primary" onClick={generate}>{t('batchGenerate', locale)}</button>
+      </div>
+      <p className="panel-hint">{t('batchPresetHint', locale)}</p>
+    </>}
+    {error && <p className="issue issue-error" role="alert">{error[locale]}{entries.length>0?` ${t('batchPrevious', locale)}`:''}</p>}
+    {entries.length>0 && <p role="status">{t('batchReady', locale, {n:entries.length})}</p>}
+  </section>;
+}
