-  "sourcesContent": ["import { dccAbilityModifier } from './dcc.js';\nexport { dccAbilityModifier };\nimport { getAbilityDisplay, getAbilityMapping, toNativeScores } from './ability-display.js';\nexport { getAbilityDisplay, getAbilityMapping, toNativeScores };\nimport { ABILITIES, RULES_VERSION, classes, freeze, methods, text, versions } from './catalog.js';\nimport type { Ability, Action, Attempt, Candidate, CreateRequest, Event, ExportedResult, Issue, Locale, Method, Rng, Scores, Session, SessionOptions, SessionView, Text, VersionId } from './types.js';\nexport type * from './types.js';\nexport { ABILITIES, RULES_VERSION };\n\nexport class RuleError extends Error {\n  readonly code: string;\n  readonly messages: Text;\n  constructor(code: string, zh: string, en: string) {\n    super(en); this.name = 'RuleError'; this.code = code; this.messages = text(zh,en);\n  }\n}\nfunction requireRule(ok: unknown, code: string, zh: string, en: string): asserts ok {\n  if (!ok) throw new RuleError(code,zh,en);\n}\nfunction object(v: unknown): asserts v is Record<string, unknown> {\n  requireRule(v !== null && typeof v === 'object' && !Array.isArray(v), 'BAD_OBJECT','\u9700\u8981\u5BF9\u8C61\u3002','Expected an object.');\n}\nfunction keys(v: Record<string,unknown>, allowed: string[]) {\n  requireRule(Object.keys(v).every(k=>allowed.includes(k)),'UNKNOWN_FIELD','\u5305\u542B\u672A\u77E5\u5B57\u6BB5\u3002','Unknown field.');\n}\nconst ability = (v: unknown): v is Ability => ABILITIES.includes(v as Ability);\nexport const isRandomMethod = (m: Method) => m.status==='ready' && (m.randomBudget===true || !['buy','array'].includes(m.mode));\nexport function formatAbilityScore(ab: Ability, score: number | undefined, percent: number | null = null): string {\n  return score===undefined?'\u2014':ab==='STR'&&score===18&&percent!==null?`18/${percent===100?'00':String(percent).padStart(2,'0')}`:String(score);\n}\nconst exceptionalVersion = (m: Method) => m.versionId==='adnd1e'||m.versionId==='adnd2e';\nconst classMode = (m: Method) => m.versionId === 'bx1981' || m.versionId === 'ose-classic';\nconst allScores = (n: number): Scores => Object.fromEntries(ABILITIES.map(a=>[a,n])) as Scores;\nconst sum = (values: number[]) => values.reduce((a,b)=>a+b,0);\nexport const listVersions = () => versions;\nexport function listMethods(versionId: VersionId): Method[] {\n  requireRule(versions.some(v=>v.id===versionId),'UNKNOWN_VERSION','\u672A\u77E5\u6E38\u620F\u7248\u672C\u3002','Unknown game version.');\n  return freeze(methods.filter(m=>m.versionId===versionId));\n}\nexport function getMethod(id: string): Method {\n  const m = methods.find(m=>m.id===id);\n  requireRule(m,'UNKNOWN_METHOD','\u672A\u77E5\u751F\u6210\u65B9\u6CD5\u3002','Unknown generation method.'); return m;\n}\nfunction normalizeRequest(input: unknown): CreateRequest {\n  object(input); keys(input,['versionId','methodId','options']);\n  requireRule(typeof input.methodId==='string','BAD_REQUEST','\u9700\u8981\u65B9\u6CD5\u6807\u8BC6\u3002','Method ID required.');\n  const m=getMethod(input.methodId);\n  requireRule(input.versionId===m.versionId,'VERSION_MISMATCH','\u65B9\u6CD5\u4E0D\u5C5E\u4E8E\u8BE5\u7248\u672C\u3002','Method does not belong to this version.');\n  requireRule(m.status==='ready','METHOD_PENDING','\u8BE5\u65B9\u6CD5\u5C1A\u672A\u6838\u51C6\uFF0C\u6682\u4E0D\u53EF\u7528\u3002','This method is pending verification.');\n  const opts=input.options??{}; object(opts); keys(opts,['budget','inOrder','poolTotal']);\n  const options: SessionOptions = {};\n  if (m.mode==='buy'&&!m.randomBudget) {\n    const budget=opts.budget??m.defaultBudget;\n    requireRule(typeof budget==='number' && m.budgets.includes(budget),'BAD_BUDGET','\u8BF7\u9009\u62E9\u5DF2\u5217\u51FA\u7684\u5B98\u65B9\u9884\u7B97\u3002','Select a listed official budget.'); options.budget=budget;\n  } else requireRule(opts.budget===undefined,'BAD_OPTION','\u8BE5\u65B9\u6CD5\u4E0D\u4F7F\u7528\u8D2D\u70B9\u9884\u7B97\u3002','This method has no point budget.');\n  if (m.canChooseOrder) {\n    requireRule(opts.inOrder===undefined || typeof opts.inOrder==='boolean','BAD_OPTION','\u4F9D\u5E8F\u9009\u9879\u987B\u4E3A\u5E03\u5C14\u503C\u3002','inOrder must be boolean.'); options.inOrder=opts.inOrder??false;\n  } else requireRule(opts.inOrder===undefined,'BAD_OPTION','\u8BE5\u65B9\u6CD5\u4E0D\u80FD\u5207\u6362\u987A\u5E8F\u3002','This method has no order option.');\n  if (m.mode==='pool') {\n    const total=opts.poolTotal??24;\n    requireRule(typeof total==='number' && m.poolTotals.includes(total),'BAD_POOL','\u9AB0\u6C60\u603B\u6570\u987B\u4E3A 24 \u6216 28\u3002','Pool total must be 24 or 28.'); options.poolTotal=total;\n  } else requireRule(opts.poolTotal===undefined,'BAD_OPTION','\u8BE5\u65B9\u6CD5\u6CA1\u6709\u9AB0\u6C60\u603B\u6570\u3002','This method has no pool total.');\n  return {versionId:m.versionId,methodId:m.id,options};\n}\nexport function createSession(request: CreateRequest): Session {\n  return freeze({schemaVersion:1,rulesVersion:RULES_VERSION,request:normalizeRequest(request),events:[]});\n}\n/** A random integer source; no Math.random fallback. Modulo bias is rejected. */\nexport function cryptoRng(sides: number): number {\n  requireRule(Number.isInteger(sides)&&sides>=2&&sides<=0x100000000,'BAD_SIDES','\u9AB0\u5B50\u9762\u6570\u65E0\u6548\u3002','Invalid die sides.');\n  requireRule(typeof globalThis.crypto?.getRandomValues==='function','NO_CRYPTO','\u5F53\u524D\u73AF\u5883\u6CA1\u6709\u5B89\u5168\u968F\u673A\u6570\u6E90\uFF0C\u8BF7\u7531\u9002\u914D\u5668\u63D0\u4F9B\u3002','No secure random source; provide one from the adapter.');\n  const a=new Uint32Array(1), limit=Math.floor(0x100000000/sides)*sides;\n  do {globalThis.crypto.getRandomValues(a);} while(a[0]!>=limit);\n  return a[0]!%sides+1;\n}\n/** Fixed dice for tests and demos only; never silently wraps around. */\nexport function sequenceRng(values: readonly number[]): Rng {\n  const copy=[...values]; let i=0;\n  return sides=>{const n=copy[i++]; requireRule(Number.isInteger(n)&&n!>=1&&n!<=sides,'BAD_RNG','\u56FA\u5B9A\u9AB0\u5E8F\u5217\u8017\u5C3D\u6216\u6570\u503C\u65E0\u6548\u3002','Fixed dice exhausted or invalid.');return n!;};\n}\nfunction normalizedAction(input: unknown): Action {\n  object(input); const t=input.type;\n  requireRule(typeof t==='string','BAD_ACTION','\u7F3A\u5C11\u64CD\u4F5C\u7C7B\u578B\u3002','Action type required.');\n  const fields: Record<string,string[]>={roll:[],rollExceptional:[],buyExceptional:['percent'],setPool:['counts'],assign:['assignments'],choosePair:['ability','candidateId'],chooseSet:['setId'],allocateDie:['dieId','ability'],setScore:['ability','score'],selectClass:['classId'],trade:['from','to'],resetAdjustments:[],reroll:['reason','note'],finalize:['acceptUnspent']};\n  requireRule(Object.hasOwn(fields,t),'BAD_ACTION','\u672A\u77E5\u64CD\u4F5C\u3002','Unknown action.'); keys(input,['type',...fields[t]!]);\n  switch(t) {\n    case 'buyExceptional': requireRule(Number.isInteger(input.percent)&&(input.percent as number)>=0&&(input.percent as number)<=100&&(input.percent as number)%10===0,'BAD_PERCENT','\u8D2D\u4E70\u767E\u5206\u6BD4\u987B\u4E3A 0\u2013100 \u7684\u5341\u500D\u6570\u3002','Purchased percentage must be a multiple of ten from 0 to 100.');break;\n    case 'setPool': object(input.counts); keys(input.counts,ABILITIES); requireRule(ABILITIES.every(a=>Number.isInteger((input.counts as Record<string,unknown>)[a])),'BAD_POOL','\u516D\u9879\u9AB0\u6570\u5FC5\u987B\u4E3A\u6574\u6570\u3002','All six dice counts must be integers.'); break;\n    case 'assign': object(input.assignments); keys(input.assignments,ABILITIES); requireRule(Object.values(input.assignments).every(v=>typeof v==='string'),'BAD_ASSIGNMENT','\u5019\u9009\u7ED3\u679C\u6807\u8BC6\u5FC5\u987B\u4E3A\u5B57\u7B26\u4E32\u3002','Candidate IDs must be strings.'); break;\n    case 'choosePair': requireRule(ability(input.ability)&&typeof input.candidateId==='string','BAD_ACTION','\u9009\u62E9\u53C2\u6570\u65E0\u6548\u3002','Invalid pair selection.'); break;\n    case 'chooseSet': requireRule(typeof input.setId==='string','BAD_ACTION','\u7F3A\u5C11\u6574\u5957\u6807\u8BC6\u3002','Set ID required.'); break;\n    case 'allocateDie': requireRule(typeof input.dieId==='string'&&(input.ability===null||ability(input.ability)),'BAD_ACTION','\u9AB0\u5B50\u5206\u914D\u53C2\u6570\u65E0\u6548\u3002','Invalid die allocation.'); break;\n    case 'setScore': requireRule(ability(input.ability)&&Number.isInteger(input.score),'BAD_ACTION','\u5C5E\u6027\u6216\u6570\u503C\u65E0\u6548\u3002','Invalid ability or score.'); break;\n    case 'selectClass': requireRule(input.classId===null||classes.some(c=>c.id===input.classId),'BAD_CLASS','\u672A\u77E5\u804C\u4E1A\u3002','Unknown class.'); break;\n    case 'trade': requireRule(ability(input.from)&&ability(input.to),'BAD_ACTION','\u4EA4\u6362\u5C5E\u6027\u65E0\u6548\u3002','Invalid exchange abilities.'); break;\n    case 'reroll': requireRule(input.reason==='rule'||input.reason==='referee','BAD_REASON','\u987B\u6307\u5B9A\u91CD\u63B7\u7406\u7531\u3002','Reroll reason required.'); requireRule(input.note===undefined||(typeof input.note==='string'&&input.note.length<=500),'BAD_NOTE','\u8BF4\u660E\u5FC5\u987B\u662F 500 \u5B57\u7B26\u4EE5\u5185\u7684\u6587\u672C\u3002','Note must be text of at most 500 characters.'); break;\n    case 'finalize': requireRule(input.acceptUnspent===undefined||typeof input.acceptUnspent==='boolean','BAD_ACTION','\u786E\u8BA4\u53C2\u6570\u65E0\u6548\u3002','Invalid confirmation.'); break;\n  }\n  return structuredClone(input) as unknown as Action;\n}\ninterface Runtime { rulesVersion: string; request: CreateRequest; method: Method; attempt: Attempt; previous: Attempt[]; done: boolean }\nfunction newAttempt(m: Method, number: number): Attempt {\n  const a: Attempt={number,exceptionalStrength:null,pointGeneration:null,candidates:[],looseDice:[],assignments:{},selectedSet:null,allocations:{},baseScores:{},scores:{},selectedClass:null,trades:[],poolCounts:allScores(3),generated:false};\n  if(m.mode==='buy'&&!m.randomBudget){a.baseScores=allScores(m.base);a.scores={...a.baseScores};a.generated=true;}\n  if(m.mode==='array') {a.candidates=[15,14,13,12,10,8].map((total,i)=>({id:`a${number}.r${i+1}`,total,dice:[],ability:null,setId:null,eligible:true}));a.generated=true;}\n  return a;\n}\nfunction rollAttempt(r: Runtime, rng: Rng) {\n  const m=r.method,a=r.attempt,order=versions.find(v=>v.id===m.versionId)!.order;\n  const die=()=>{const n=rng(6);requireRule(Number.isInteger(n)&&n>=1&&n<=6,'BAD_RNG','\u968F\u673A\u6E90\u5FC5\u987B\u8FD4\u56DE 1\u20136 \u7684\u6574\u6570\u3002','RNG must return an integer from 1 to 6.');return n;};\n  function group(count: number, target: Ability|null=null, setId: string|null=null): Candidate {\n    const id=`a${a.number}.r${a.candidates.length+1}`;\n    const values=Array.from({length:count},()=>die());\n    const kept=new Set(values.map((v,i)=>({v,i})).sort((x,y)=>y.v-x.v||x.i-y.i).slice(0,m.keep).map(x=>x.i));\n    const dice=values.map((value,i)=>({id:`${id}.d${i+1}`,value,kept:kept.has(i)}));\n    const c={id,dice,total:sum(dice.filter(d=>d.kept).map(d=>d.value))+m.bonus,ability:target,setId,eligible:true};\n    a.candidates.push(c);return c;\n  }\n  if(m.randomBudget) {\n    const rolls=[die(),die()], row=POINT_GENERATION[sum(rolls)-2]!;\n    a.pointGeneration={rolls,budget:row[0],maximum:row[1]};a.baseScores=allScores(3);a.scores={...a.baseScores};a.generated=true;return;\n  }\n  if(m.mode==='allocate') {\n    a.looseDice=Array.from({length:7},(_,i)=>({id:`a${a.number}.d${i+1}`,value:die(),kept:true}));a.baseScores=allScores(8);\n  } else if(m.mode==='sets') {\n    for(let i=1;i<=12;i++) for(const stat of order) group(3,stat,`a${a.number}.set${i}`);\n  } else if(m.mode==='pairs'||m.mode==='best-per-ability') {\n    for(const stat of order){const batch=Array.from({length:m.mode==='pairs'?2:6},()=>group(3,stat));\n      if(m.mode==='best-per-ability') {const best=[...batch].sort((x,y)=>y.total-x.total)[0]!;a.assignments[stat]=best.id;a.baseScores[stat]=best.total;}}\n  } else if(m.mode==='pool') {\n    for(const stat of order) {const c=group(a.poolCounts[stat],stat);a.baseScores[stat]=c.total;a.assignments[stat]=c.id;}\n  } else {\n    const fixed=m.mode==='fixed'||r.request.options?.inOrder===true;\n    const count=m.mode==='best-six'||m.id==='adnd2e.phb-IV'?12:6;\n    for(let i=0;i<count;i++){const target=fixed?order[i]!:null,c=group(m.diceCount,target);if(target){a.baseScores[target]=c.total;a.assignments[target]=c.id;}}\n    if(m.mode==='best-six') {const cutoff=[...a.candidates].sort((x,y)=>y.total-x.total)[5]!.total;for(const c of a.candidates)c.eligible=c.total>=cutoff;}\n  }\n  a.generated=true; a.scores={...a.baseScores};\n}\nconst POINT_GENERATION = [[68,18],[70,18],[72,17],[72,18],[74,17],[74,18],[76,17],[76,16],[78,16],[78,15],[80,15]] as const;\nfunction pointBuy(r: Runtime): SessionView['pointBuy'] {\n  if(r.method.mode!=='buy'||!r.attempt.generated)return null;\n  const costs=Object.fromEntries(Object.entries(r.method.costs).filter(([score])=>Number(score)<=(r.attempt.pointGeneration?.maximum??18)));\n  const extra=r.method.id==='adnd2e.sp-X'&&r.attempt.scores.STR===18?(r.attempt.exceptionalStrength??0)/10:0;\n  const spent=sum(ABILITIES.map(a=>costs[String(r.attempt.scores[a])]!))+extra,budget=r.attempt.pointGeneration?.budget??r.request.options!.budget!;\n  return {spent,budget,remaining:budget-spent,costs};\n}\nfunction issues(r: Runtime): Issue[] {\n  const out: Issue[]=[],a=r.attempt;\n  const push=(code: string,zh: string,en: string,severity: Issue['severity']='error')=>out.push({code,severity,message:text(zh,en)});\n  if(!a.generated)push('NOT_GENERATED','\u5C1A\u672A\u751F\u6210\u5C5E\u6027\u3002','Generate scores first.');\n  else if(!ABILITIES.every(s=>a.scores[s]!==undefined))push('INCOMPLETE','\u8BF7\u5B8C\u6210\u6240\u6709\u9009\u62E9\u6216\u5206\u914D\u3002','Complete all selections or assignments.');\n  if(r.method.mode==='allocate' && a.generated && Object.keys(a.allocations).length!==7)push('UNALLOCATED','\u8FD8\u6709\u9AB0\u5B50\u672A\u5206\u914D\u3002','Some dice remain unallocated.');\n  if(r.method.mode==='best-six'&&Object.keys(a.assignments).length===6){\n    const chosen=Object.values(a.assignments).map(id=>a.candidates.find(c=>c.id===id)!.total).sort((x,y)=>y-x);\n    const expected=a.candidates.map(c=>c.total).sort((x,y)=>y-x).slice(0,6);\n    if(chosen.some((n,i)=>n!==expected[i]))push('NOT_BEST_SIX','\u5FC5\u987B\u4FDD\u7559\u6700\u9AD8\u516D\u4E2A\u603B\u548C\u3002','Retain the six highest totals.');\n  }\n  const pb=pointBuy(r);\n  if(pb&&pb.remaining<0)push('OVER_BUDGET','\u8D2D\u70B9\u8D85\u51FA\u9884\u7B97\u3002','Point budget exceeded.');\n  if(pb&&pb.remaining>0)push('UNSPENT',r.method.id.startsWith('adnd2e.sp-')?'\u5FC5\u987B\u5206\u914D\u5168\u90E8\u5C5E\u6027\u70B9\u3002':'\u4ECD\u6709\u70B9\u6570\u672A\u4F7F\u7528\uFF1B\u5B8C\u6210\u65F6\u9700\u660E\u786E\u786E\u8BA4\u3002',r.method.id.startsWith('adnd2e.sp-')?'Allocate all ability points.':'Points remain; explicitly acknowledge them when finalizing.',r.method.id.startsWith('adnd2e.sp-')?'error':'warning');\n  if(exceptionalVersion(r.method)&&r.method.mode==='buy'&&r.method.id!=='adnd2e.sp-X'&&a.scores.STR===18&&a.exceptionalStrength===null)push('EXCEPTIONAL_REQUIRED','\u8BF7\u70B9\u51FB\u6295\u63B7\u4F20\u5947\u529B\u91CF\u3002','Click to roll exceptional Strength.');\n  return out;\n}\nfunction ruleReroll(r: Runtime): boolean {\n  if(r.method.id!=='dnd35.phb-roll'||!r.attempt.generated)return false;\n  const vals=r.attempt.candidates.map(c=>c.total);\n  return Math.max(...vals)<=13 || sum(vals.map(v=>Math.floor((v-10)/2)))<=0;\n}\nfunction transition(r: Runtime, action: Action, rng: Rng) {\n  requireRule(!r.done,'COMPLETED','\u5DF2\u5B8C\u6210\u7684\u8BB0\u5F55\u4E0D\u80FD\u4FEE\u6539\uFF0C\u8BF7\u65B0\u5EFA\u4E00\u6B21\u751F\u6210\u3002','Completed sessions are locked; start a new session.');\n  const a=r.attempt,m=r.method;\n  const generated=()=>requireRule(a.generated,'NOT_GENERATED','\u8BF7\u5148\u751F\u6210\u5C5E\u6027\u3002','Generate scores first.');\n  switch(action.type) {\n    case 'rollExceptional': {\n      generated();requireRule(exceptionalVersion(m)&&a.scores.STR===18&&m.id!=='adnd2e.sp-X'&&a.exceptionalStrength===null,'EXCEPTIONAL_NOT_ALLOWED','\u5F53\u524D\u4E0D\u80FD\u6295\u63B7\u4F20\u5947\u529B\u91CF\u3002','Exceptional Strength cannot be rolled now.');\n      const n=rng(100);requireRule(Number.isInteger(n)&&n>=1&&n<=100,'BAD_RNG','\u767E\u5206\u9AB0\u5FC5\u987B\u4E3A 1\u2013100\u3002','Percentile die must be 1\u2013100.');a.exceptionalStrength=n;break;\n    }\n    case 'buyExceptional':\n      generated();requireRule(m.id==='adnd2e.sp-X'&&a.scores.STR===18,'EXCEPTIONAL_NOT_ALLOWED','\u53EA\u6709\u65B9\u6CD5 X \u7684 STR 18 \u53EF\u8D2D\u4E70\u4F20\u5947\u529B\u91CF\u3002','Only Method X at STR 18 can buy exceptional Strength.');a.exceptionalStrength=action.percent||null;break;\n\n    case 'setPool':\n      requireRule(m.mode==='pool'&&!a.generated,'WRONG_PHASE','\u53EA\u80FD\u5728\u63B7\u9AB0\u524D\u5206\u914D\u9AB0\u6570\u3002','Allocate pool counts before rolling.');\n      requireRule(ABILITIES.every(s=>action.counts[s]>=3&&action.counts[s]<=(m.poolMax??r.request.options!.poolTotal!)),'BAD_POOL','\u6BCF\u9879\u9AB0\u6570\u8D85\u51FA\u672C\u65B9\u6CD5\u8303\u56F4\u3002','Dice count outside this method\u2019s range.');\n      requireRule(sum(Object.values(action.counts))===r.request.options!.poolTotal,'BAD_POOL_TOTAL','\u5FC5\u987B\u6070\u597D\u5206\u914D\u5168\u90E8\u9AB0\u6C60\u3002','Allocate exactly the full dice pool.');\n      a.poolCounts={...action.counts};break;\n    case 'roll':\n      requireRule(!a.generated,'ALREADY_ROLLED','\u5DF2\u7ECF\u751F\u6210\uFF0C\u4E0D\u80FD\u91CD\u590D\u63B7\u9AB0\u3002','Already generated; cannot roll again.');\n      if(m.mode==='pool')requireRule(sum(Object.values(a.poolCounts))===r.request.options!.poolTotal,'BAD_POOL_TOTAL','\u8BF7\u5148\u5206\u914D\u5168\u90E8\u9AB0\u6C60\u3002','Allocate the full pool first.');\n      rollAttempt(r,rng);break;\n    case 'assign': {\n      generated();requireRule(['assign','best-six','array'].includes(m.mode)&&!r.request.options?.inOrder,'WRONG_ACTION','\u8BE5\u65B9\u6CD5\u4E0D\u80FD\u81EA\u7531\u5206\u914D\u3002','This method does not permit free assignment.');\n      const ids=Object.values(action.assignments);\n      requireRule(new Set(ids).size===ids.length,'DUPLICATE_RESULT','\u540C\u4E00\u4E2A\u7ED3\u679C\u4E0D\u80FD\u91CD\u590D\u4F7F\u7528\u3002','A result cannot be assigned twice.');\n      requireRule(ids.every(id=>a.candidates.some(c=>c.id===id&&c.eligible)),'BAD_CANDIDATE','\u7ED3\u679C\u4E0D\u5B58\u5728\u6216\u4E0D\u53EF\u9009\u62E9\u3002','Unknown or ineligible candidate.');\n      a.assignments={...action.assignments};a.baseScores={};\n      for(const stat of ABILITIES){const id=a.assignments[stat];if(id)a.baseScores[stat]=a.candidates.find(c=>c.id===id)!.total;}\n      a.scores={...a.baseScores};break;\n    }\n    case 'choosePair': {\n      generated();requireRule(m.mode==='pairs','WRONG_ACTION','\u8BE5\u65B9\u6CD5\u4E0D\u662F\u9010\u9879\u4E8C\u9009\u4E00\u3002','Not a per-ability pair method.');\n      const c=a.candidates.find(c=>c.id===action.candidateId&&c.ability===action.ability);\n      requireRule(c,'BAD_CANDIDATE','\u53EA\u80FD\u9009\u62E9\u8BE5\u5C5E\u6027\u7684\u5019\u9009\u7ED3\u679C\u3002','Choose a candidate belonging to this ability.');\n      a.assignments[action.ability]=c.id;a.baseScores[action.ability]=c.total;a.scores={...a.baseScores};break;\n    }\n    case 'chooseSet':\n      generated();requireRule(m.mode==='sets','WRONG_ACTION','\u8BE5\u65B9\u6CD5\u4E0D\u662F\u6574\u5957\u9009\u62E9\u3002','Not a whole-set method.');\n      {const cs=a.candidates.filter(c=>c.setId===action.setId);requireRule(cs.length===6,'BAD_SET','\u657