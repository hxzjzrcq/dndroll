) {\n    case 'rollExceptional': {\n      generated();requireRule(exceptionalVersion(m)&&a.scores.STR===18&&m.id!=='adnd2e.sp-X'&&a.exceptionalStrength===null,'EXCEPTIONAL_NOT_ALLOWED','\u5F53\u524D\u4E0D\u80FD\u6295\u63B7\u4F20\u5947\u529B\u91CF\u3002','Exceptional Strength cannot be rolled now.');\n      const n=rng(100);requireRule(Number.isInteger(n)&&n>=1&&n<=100,'BAD_RNG','\u767E\u5206\u9AB0\u5FC5\u987B\u4E3A 1\u2013100\u3002','Percentile die must be 1\u2013100.');a.exceptionalStrength=n;break;\n    }\n    case 'buyExceptional':\n      generated();requireRule(m.id==='adnd2e.sp-X'&&a.scores.STR===18,'EXCEPTIONAL_NOT_ALLOWED','\u53EA\u6709\u65B9\u6CD5 X \u7684 STR 18 \u53EF\u8D2D\u4E70\u4F20\u5947\u529B\u91CF\u3002','Only Method X at STR 18 can buy exceptional Strength.');a.exceptionalStrength=action.percent||null;break;\n\n    case 'setPool':\n      requireRule(m.mode==='pool'&&!a.generated,'WRONG_PHASE','\u53EA\u80FD\u5728\u63B7\u9AB0\u524D\u5206\u914D\u9AB0\u6570\u3002','Allocate pool counts before rolling.');\n      requireRule(ABILITIES.every(s=>action.counts[s]>=3&&action.counts[s]<=(m.poolMax??r.request.options!.poolTotal!)),'BAD_POOL','\u6BCF\u9879\u9AB0\u6570\u8D85\u51FA\u672C\u65B9\u6CD5\u8303\u56F4\u3002','Dice count outside this method\u2019s range.');\n      requireRule(sum(Object.values(action.counts))===r.request.options!.poolTotal,'BAD_POOL_TOTAL','\u5FC5\u987B\u6070\u597D\u5206\u914D\u5168\u90E8\u9AB0\u6C60\u3002','Allocate exactly the full dice pool.');\n      a.poolCounts={...action.counts};break;\n    case 'roll':\n      requireRule(!a.generated,'ALREADY_ROLLED','\u5DF2\u7ECF\u751F\u6210\uFF0C\u4E0D\u80FD\u91CD\u590D\u63B7\u9AB0\u3002','Already generated; cannot roll again.');\n      if(m.mode==='pool')requireRule(sum(Object.values(a.poolCounts))===r.request.options!.poolTotal,'BAD_POOL_TOTAL','\u8BF7\u5148\u5206\u914D\u5168\u90E8\u9AB0\u6C60\u3002','Allocate the full pool first.');\n      rollAttempt(r,rng);break;\n    case 'assign': {\n    